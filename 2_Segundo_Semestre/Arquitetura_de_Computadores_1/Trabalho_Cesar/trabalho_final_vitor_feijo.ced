;Trabalho Cesar versão 2




;==========================================================================
; Área Reservada


                org                h7f00
STACK:


; Acesso em 16 bits
                org                hff80
                daw                [31]                ; Área reservada
IVET:        dw                0                        ; Vetor de interrupção


; Acesso em 8 bits
                dab                [23]
TIMDT:        db                0
INTS:        db                0                        ; INTERRUPT STATUS: IP x x x . x x IPStec IPStim
INTE:        db                0                        ; INTERRUPT ENABLE: IE x x x . x x IEStec IEStim
TECST:        db                0                        ; Status do teclado
TECDT:        db                0                        ; Dado do teclado
VISOR:        dab                [36]                ; Portas de acesso ao visor


;Valores na memoria
org h8000




robo1: dw 0
xRobo1: dw 0
yRobo1: dw 0
vxRobo1: dw 0
vyRobo1: dw 0
NomeRobo1: dab 'ROBO1'




robo2: dw 0
xRobo2: dw 0
yRobo2: dw 0
vxRobo2: dw 0
vyRobo2: dw 0
NomeRobo2: dab 'ROBO2'


robo3: dw 0
xRobo3: dw 0
yRobo3: dw 0
vxRobo3: dw 0
vyRobo3: dw 0
NomeRobo3: dab 'ROBO3'


robo4: dw 0
xRobo4: dw 0
yRobo4: dw 0
vxRobo4: dw 0
vyRobo4: dw 0
NomeRobo4: dab 'ROBO4'


stringRobox: dab '0000'
stringRoboy: dab '0000'
stringRobovx: dab '00'
stringRobovy: dab '00'


;0 - nenhum robo ligado
;1 - robo 1
;1 - robo 2
;1 - robo 3
;1 - robo 4
RoboFoco: dw 0 


RobosParados: dab 'ROBOS PARADOS'
FraseNomeRobo1: dab 'NOME DO ROBO 1: '
FraseNomeRobo2: dab 'NOME DO ROBO 2: '
FraseNomeRobo3: dab 'NOME DO ROBO 3: '
FraseNomeRobo4: dab 'NOME DO ROBO 4: '


decimos: dw 0
umsegundo: dw 0

doisdecimos: dw 0
doissegundo: dw 0

NAOHAROBOSLIVRES: dab 'NAO HA ROBOS LIVRES'

Tecla: dw -1

teclaPressionada: dw 0
contadorLetras: dw 0







;==========================================================================
; Programa Principal
org 0


MOV #STACK, R6


;Limpeza das variaveis
CLR robo1
CLR robo2
CLR robo3
CLR robo4


CLR umsegundo


MOV #-1, R5




;Setando as interrupções


CLR TECST
CLR TECDT
CLR INTS


MOV #h83, INTE 
MOV #rotinainterrupcao, IVET
MOV #100, TIMDT




; LOOP MAIN


loopmain:


JSR R7, TestaRobosDesativados ;Se todos os robos estiverem desativados 
                              ;escreve robos parados




JSR R7, DigitacaoNomeRobo ;Se a tecla N ou n for digitada aciona um robo


JSR R7, RoboFocado ;Verifica qual o robo focado



JSR R7, InfoRobos  

JSR R7,  ImputTeclado

JSR R7, funcaoDeslocamento


BR loopmain
HLT










;;------------------------------------------------


; Minhas Funções


; Minhas Funções

; funcao que incrementa os deslocamentos
funcaoDeslocamento:

;deu um segundo?
TST umsegundo
BEQ naopassousegundo

CLR umsegundo

;if (robo1 == 1)
TST robo1
BEQ roboDesativado1

;Adiciona o velocidade ao deslocamento
ADD vxrobo1, xrobo1

;if( deslocamento > 9999) então ele vai até o maximo
CMP xrobo1, 9999
BLE roboignoradomaiorx1
;MOV #9999, xrobo1

roboignoradomaiorx1:
;if(deslocamento < -9999) então ele vai até o minimo
CMP xrobo1, -9999
BGE roboignoradomenorx1
;MOV #-9999, xrobo1

roboignoradomenorx1:

;Adiciona o velocidade ao deslocamento
ADD vyrobo1, yrobo1

;if( deslocamento > 9999)
CMP yrobo1, 9999
BLE roboignoradomaiory1
;MOV #9999, yrobo1


roboignoradomaiory1:
;if( deslocamento > -9999)
CMP yrobo1, -9999
BGE roboignoradomenory1
;MOV #-9999, yrobo1

roboignoradomenory1:
roboDesativado1:


naopassousegundo:

RTS R7






;=============================================================================
;função que lida com as interrupçoes do teclado do robo focado
ImputTeclado:


;if(robofoco == 1 && robo1 == 1)
CMP RoboFoco, #1
BNE SemImput1
TST robo1
BEQ SemImput1

MOV #vxrobo1, R3
JSR R7, ImputWASD

MOV #robo1, R3
JSR R7, ImputRZ

SemImput1:

;if(robofoco == 2 && robo1 == 2)
CMP RoboFoco, #2
BNE SemImput2
TST robo2
BEQ SemImput2

MOV #vxrobo2, R3
JSR R7, ImputWASD

MOV #robo2, R3
JSR R7, ImputRZ

SemImput2:

;if(robofoco == 3 && robo1 == 3)
CMP RoboFoco, #3
BNE SemImput3
TST robo3
BEQ SemImput3

MOV #vxrobo3, R3
JSR R7, ImputWASD

MOV #robo3, R3
JSR R7, ImputRZ

SemImput3:

;if(robofoco == 4 && robo1 == 4)
CMP RoboFoco, #4
BNE SemImput4
TST robo4
BEQ SemImput4

MOV #vxrobo4, R3
JSR R7, ImputWASD

MOV #robo4, R3
JSR R7, ImputRZ

SemImput4:

RTS R7


;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++


;Funcoes adicionais para ImputTeclado


;R3 = ‘endereco do vx e vy do robo’
ImputWASD:


;if(R5 == ‘w’ || R5 == ‘W’)
CMP R5, #'w'
BEQ continuaW
CMP R5, #'W'
BEQ continuaW
BR SemImputW
continuaW: ;teve o Imput W


;testa se o vy é maior que 99
cmp 2(R3), #98
bgt velocidademaximavy

inc r4

CLR R5 ;Limpa a tecla
INC 2(R3) ;incrementa o Vy


velocidademaximavy:
SemImputW:


;if(R5 == ‘a’ || R5 == ‘A’)
CMP R5, #'a'
BEQ continuaA
CMP R5, #'A'
BEQ continuaA
BR SemImputA
continuaA:

;testa se o vx é menor que -99
cmp (R3), #-98
blt velocidademinimavx


CLR R5 ;Limpa a tecla
DEC (R3) ;decrementa o Vx

velocidademinimavx:
SemImputA:


;if(R5 == ‘s’ || R5 == ‘S’)
CMP R5, #'s'
BEQ continuaS
CMP R5, #'S'
BEQ continuaS
BR SemImputS
continuaS:

;testa se o vy é menor que -99
cmp 2(R3), #-98
blt velocidademinimavy

CLR R5 ;Limpa a tecla
DEC 2(R3) ;decrementa o Vy



velocidademinimavy:
SemImputS:


;if(R5 == ‘d’ || R5 == ‘D’)
CMP R5, #'d'
BEQ continuaD
CMP R5, #'D'
BEQ continuaD
BR SemImputD
continuaD:

;testa se o vx é maior que 99
cmp (R3), #98
bgt velocidademaximavx

CLR R5 ;Limpa a tecla
INC (R3) ;incrementa o Vx



velocidademaximavx:
SemImputD:


RTS R7




;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++


ImputRZ:


;if(R5 == ‘r’ || R5 == ‘R’)
CMP R5, #'r'
BEQ continuaR
CMP R5, #'R'
BEQ continuaR
BR SemImputR
continuaR:


CLR R5 ;Limpa a tecla
;desativa o robo, zera velocidades e foca no proximo robo
CLR (R3)
CLR 6(R3)
CLR 8(R3)

TST robo1
BEQ proximorobo1r
MOV #1, RoboFoco
BR Fimr

proximorobo1r:
TST robo2
BEQ proximorobo2r
MOV #2, RoboFoco
BR Fimr

proximorobo2r:
TST robo3
BEQ proximorobo3r
MOV #3, RoboFoco
BR Fimr

proximorobo3r:
TST robo4
BEQ Fimr
MOV #4, RoboFoco
BR Fimr

Fimr:


;Limpa visor
JSR R7, LimpaVisor

SemImputR:



;if(R5 == ‘z’ || R5 == ‘Z’)
CMP R5, #'z'
BEQ continuaZ
CMP R5, #'Z'
BEQ continuaZ
BR SemImputZ
continuaZ:


CLR R5 ;Limpa a tecla
;zera as velocidades
CLR 6(R3)
CLR 8(R3)

SemImputZ:



RTS R7




















;=============================================================================
;função que coloca na tela as informações do robo focado
InfoRobos:


;if(robofoco == 1 && robo1 == 1)
CMP RoboFoco, #1
BNE naoFocoRobo1
TST robo1
BEQ naoFocoRobo1


JSR R7, escreveVisorRobo1


naoFocoRobo1:


;if(robofoco == 2 && robo1 == 2)
CMP RoboFoco, #2
BNE naoFocoRobo2
TST robo2
BEQ naoFocoRobo2


JSR R7, escreveVisorRobo2


naoFocoRobo2:


;if(robofoco == 3 && robo1 == 3)
CMP RoboFoco, #3
BNE naoFocoRobo3
TST robo3
BEQ naoFocoRobo3


JSR R7, escreveVisorRobo3


naoFocoRobo3:


;if(robofoco == 4 && robo1 == 4)
CMP RoboFoco, #4
BNE naoFocoRobo4
TST robo4
BEQ naoFocoRobo4


JSR R7, escreveVisorRobo4


naoFocoRobo4:




RTS R7




;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;funções auxiliares de InfoRobos:


escreveVisorRobo1:


MOV	#xRobo1, -(R6)	
MOV	#stringRobox, -(R6)	
;JSR	R7, int2str
ADD	#4, R6

MOV	#yRobo1, -(R6)	
MOV	#stringRoboy, -(R6)	
;JSR	R7, int2str
ADD	#4, R6

MOV	#vxRobo1, -(R6)	
MOV	#stringRobovx, -(R6)	
;JSR	R7, int2str
ADD	#4, R6

MOV	#vyRobo1, -(R6)	
MOV	#stringRobovy, -(R6)	
;JSR	R7, int2str
ADD	#4, R6



MOV #5, R0      ; tamanho da mensagem (em caracteres)
MOV #NomeRobo1, R1      ; endereco da mensagem a ser escrita no visor
MOV #VISOR, R2         ; endereco do LED onde deve iniciar a mensagem
JSR R7, escreveVisor


MOV #'X', 65506
MOV #':', 65507

MOV #' ', 65508

MOV #4, R0      ; tamanho da mensagem (em caracteres)
MOV #stringRobox, R1      ; endereco da mensagem a ser escrita no visor
MOV #VISOR+9, R2         ; endereco do LED onde deve iniciar a mensagem
JSR R7, escreveVisor




MOV #'Y', 65514
MOV #':', 65515

MOV #' ', 65516


MOV #4, R0      ; tamanho da mensagem (em caracteres)
MOV #stringRoboy, R1      ; endereco da mensagem a ser escrita no visor
MOV #VISOR+17, R2         ; endereco do LED onde deve iniciar a mensagem
JSR R7, escreveVisor


MOV #'V', 65522
MOV #'X', 65523
MOV #':', 65524

MOV #' ', 65525

MOV #2, R0      ; tamanho da mensagem (em caracteres)
MOV #stringRobovx, R1      ; endereco da mensagem a ser escrita no visor
MOV #VISOR+26, R2         ; endereco do LED onde deve iniciar a mensagem
JSR R7, escreveVisor




MOV #'V', 65529
MOV #'Y', 65530
MOV #':', 65531

MOV #' ', 65532

MOV #2, R0      ; tamanho da mensagem (em caracteres)
MOV #stringRobovy, R1      ; end12111212121211112341ereco da mensagem a ser escrita no visor
MOV #VISOR+33, R2         ; endereco do LED onde deve iniciar a mensagem
JSR R7, escreveVisor


RTS R7


;+++++++++++++++++++
escreveVisorRobo2:



MOV #5, R0      ; tamanho da mensagem (em caracteres)
MOV #NomeRobo2, R1      ; endereco da mensagem a ser escrita no visor
MOV #VISOR, R2         ; endereco do LED onde deve iniciar a mensagem

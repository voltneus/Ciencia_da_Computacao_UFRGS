;=============================================================================
;função que troca o foco do robo caso o numero do robo seja digitado
RoboFocado:


;if (R5 = 1 && robo = 1)
CMP R5, #'1'
BNE SemNumero1
TST robo1
BEQ SemNumero1




CLR R5
MOV #1, RoboFoco ;muda o foco do robo
JSR R7, LimpaVisor


SemNumero1:


;if (R5 = 2 && robo = 2)
CMP R5, #'2'
BNE SemNumero2
TST robo2
BEQ SemNumero2




CLR R5
MOV #2, RoboFoco ;muda o foco do robo
JSR R7, LimpaVisor


SemNumero2:


;if (R5 = 3 && robo = 3)
CMP R5, #'3'
BNE SemNumero3
TST robo3
BEQ SemNumero3


CLR R5
MOV #3, RoboFoco ;muda o foco do robo
JSR R7, LimpaVisor


SemNumero3:


;if (R5 = 4 && robo = 4)
CMP R5, #'4'
BNE SemNumero4
TST robo4
BEQ SemNumero4


CLR R5
MOV #4, RoboFoco ;muda o foco do robo
JSR R7, LimpaVisor


SemNumero4:


RTS R7






;=============================================================================
;Função que trata o acionamento dos robos e futuramente o nome deles
DigitacaoNomeRobo:


;if tecla = 'N' || 'n'
CMP R5, #'n'
BEQ ContinuaN
CMP R5, #'N'
BEQ ContinuaN
JMP pulaDigitacaoNomeRoboxx
ContinuaN:


CLR R5

JSR R7, LimpaVisor

TST robo1
BNE proximorobo2   ;Caso estela ativado


INC robo1 ;ativa o robo
MOV #1, RoboFoco ;muda o foco do robo
br pulaDigitacaoNomeRoboxx
JSR R7, LimpaVisor


proximorobo2:
TST robo2
BNE proximorobo3   ;Caso estela ativado




INC robo2 ;ativa o robo
MOV #2, RoboFoco ;muda o foco do robo
br pulaDigitacaoNomeRoboxx
JSR R7, LimpaVisor


proximorobo3:
TST robo3
BNE proximorobo4   ;Caso estela ativado




INC robo3 ;ativa o robo
MOV #3, RoboFoco ;muda o foco do robo
br pulaDigitacaoNomeRoboxx
JSR R7, LimpaVisor


proximorobo4:
TST robo4 
BNE NenhumRoboLigado ;Caso todos estejam ativados(mensagem 2 seg) **** ALERTA A FAZER




INC robo4 ;ativa o robo
MOV #4, RoboFoco ;muda o foco do robo
br pulaDigitacaoNomeRoboxx
JSR R7, LimpaVisor


NenhumRoboLigado: ;ainda a fazer

JSR R7, LimpaVisor
MOV #0, doisdecimos

MOV #19, R0                      ; tamanho da mensagem (em caracteres) 
MOV #NAOHAROBOSLIVRES, R1          ; endereco da mensagem a ser escrita no visor 
MOV #VISOR, R2               ; Esta posição já estava correta 
JSR R7, escreveVisor

loopdoissegundos:
CMP doisdecimos, #20
BLE loopdoissegundos

JSR R7, LimpaVisor




pulaDigitacaoNomeRoboxx:






RTS R7




;=============================================================================
;Função que testa se todos os robos estão desativados:


TestaRobosDesativados:


TST robo1
BNE FimFuncaoRoboDesativado ;Caso estela ativado


TST robo2
BNE FimFuncaoRoboDesativado ;Caso estela ativado


TST robo3
BNE FimFuncaoRoboDesativado ;Caso estela ativado


TST robo4
BNE FimFuncaoRoboDesativado ;Caso estela ativado


;Coloca ROBOS PARADOS no visor


MOV #13, R0      ; tamanho da mensagem (em caracteres)
MOV #RobosParados, R1      ; endereco da mensagem a ser escrita no visor
MOV #VISOR, R2         ; endereco do LED onde deve iniciar a mensagem
JSR R7, escreveVisor




FimFuncaoRoboDesativado:


RTS R7


;-----------------------------------------------------------------------------
;Função de interrupções


rotinainterrupcao:


MOV R0, -(R6)
MOV R1, -(R6)
MOV R2, -(R6)
MOV R3, -(R6)


MOV INTS, R0
AND #2, R0
BEQ testaTimer
JSR R7, rotinatratamentoTECLADO


testaTimer:
MOV INTS, R0 
AND #1, R0
BEQ fimrotinainterrupcao
JSR R7, rotinatratamentoTIMER






fimrotinainterrupcao:


CLR INTS  ;Desliga bit de INT TECLADO E TIMER




MOV (R6)+, R3
MOV (R6)+, R2
MOV (R6)+, R1
MOV (R6)+, R0


RTI




rotinatratamentoTECLADO:


MOV TECDT, R5
MOV #1, teclaPressionada


CLR TECST


RTS R7






rotinatratamentoTIMER:

inc doisdecimos
INC decimos
CMP decimos, #10
BLT rotinatratamentoTIMERfim


CLR decimos
INC umsegundo


rotinatratamentoTIMERfim:


RTS R7


